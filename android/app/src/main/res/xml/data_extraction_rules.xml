<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up to the cloud or copied device-to-device: pairing
    tokens are bound to this device's Android Keystore key and would be
    useless (and confusing) on another device, and the upload queue only
    references local media.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
