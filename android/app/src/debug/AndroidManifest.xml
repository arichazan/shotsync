<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test hook: receives a pairing QR payload via adb broadcast
     so automated/CI tests can exercise the real pairing stack without a
     camera or keyboard. Not present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.PairDebugReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.shotsync.app.DEBUG_PAIR" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
